<mxfile host="app.diagrams.net"><diagram name="Despliegue v2" id="sd-castro-osorio-v2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="740" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="&lt;b&gt;Despliegue v2 · Tabla de puntajes (Juegos) · tres niveles&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="sub" value="Sistemas Distribuidos FDICI25 · Equipo Castro - Osorio" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1100" height="22" as="geometry"/></mxCell><mxCell id="host" value="Computador del equipo (anfitrión)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#595959;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1230" height="500" as="geometry"/></mxCell><mxCell id="net" value="Red Docker sd_net" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBE9EA;strokeColor=#C1272D;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#C1272D;" vertex="1" parent="1"><mxGeometry x="280" y="105" width="965" height="445" as="geometry"/></mxCell><mxCell id="lane1" value="Nivel 1 · Entrada" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F4E79;dashed=1;dashPattern=2 4;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="200" height="400" as="geometry"/></mxCell><mxCell id="lane2" value="Nivel 2 · Puerta sin estado" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F4E79;dashed=1;dashPattern=2 4;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="530" y="135" width="240" height="400" as="geometry"/></mxCell><mxCell id="lane3" value="Nivel 3 · Servidor con estado" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C1272D;dashed=1;dashPattern=2 4;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#C1272D;" vertex="1" parent="1"><mxGeometry x="800" y="135" width="420" height="400" as="geometry"/></mxCell><mxCell id="nav" value="&lt;b style=&quot;font-size:13px&quot;&gt;navegador&lt;/b&gt;&lt;br&gt;fuera de Docker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;strokeWidth=2;fontSize=11;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="65" y="285" width="135" height="74" as="geometry"/></mxCell><mxCell id="ngx" value="&lt;b style=&quot;font-size:13px&quot;&gt;nginx&lt;/b&gt;&lt;br&gt;sd_nginx&lt;br&gt;entrada única" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="330" y="285" width="140" height="74" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b style=&quot;font-size:13px&quot;&gt;cliente&lt;/b&gt;&lt;br&gt;sd_cliente&lt;br&gt;cliente_http.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;strokeWidth=2;fontSize=11;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="140" height="74" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b style=&quot;font-size:13px&quot;&gt;api1&lt;/b&gt;&lt;br&gt;sd_api1 · FastAPI&lt;br&gt;sin estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="570" y="180" width="165" height="78" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b style=&quot;font-size:13px&quot;&gt;api2&lt;/b&gt;&lt;br&gt;sd_api2 · FastAPI&lt;br&gt;sin estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="570" y="390" width="165" height="78" as="geometry"/></mxCell><mxCell id="srv" value="&lt;b style=&quot;font-size:13px&quot;&gt;servidor&lt;/b&gt;&lt;br&gt;sd_servidor · servidor.py&lt;br&gt;hilo por cliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9EA;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="840" y="280" width="180" height="84" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Protocolo de texto&lt;/b&gt;&lt;br&gt;TABLA&lt;br&gt;UNIR &amp;lt;jugador&amp;gt;&lt;br&gt;ANOTAR &amp;lt;jugador&amp;gt; &amp;lt;puntos&amp;gt;&lt;br&gt;OK ... / ERROR ..." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;fontSize=11;align=left;spacingLeft=8;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="840" y="165" width="180" height="96" as="geometry"/></mxCell><mxCell id="est" value="&lt;b&gt;Estado compartido&lt;/b&gt;&lt;br&gt;puntajes en memoria&lt;br&gt;protegidos con Lock" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B26A00;fontSize=11;align=center;spacingLeft=8;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="840" y="385" width="180" height="70" as="geometry"/></mxCell><mxCell id="cae" value="&lt;b&gt;Qué pasa si se cae cada nodo&lt;/b&gt;&lt;br&gt;api1 o api2 · nginx reparte todo a la otra réplica, el cliente no se entera&lt;br&gt;nginx · nada entra al sistema, es la única puerta publicada&lt;br&gt;servidor · todo responde 503 y se pierden los puntajes, es el punto único de falla&lt;br&gt;cliente · solo se pierde la herramienta de pruebas" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;fontSize=11;align=left;spacingLeft=8;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1230" height="100" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b&gt;HTTP 8080 → 80&lt;/b&gt;&lt;br&gt;publicado al anfitrión" style="endArrow=block;html=1;rounded=0;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#1F4E79;labelBackgroundColor=#F4F4F4;" edge="1" parent="1" source="nav" target="ngx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;HTTP 8000&lt;/b&gt;" style="endArrow=block;html=1;rounded=0;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#1F4E79;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="ngx" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;HTTP 8000&lt;/b&gt;" style="endArrow=block;html=1;rounded=0;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#1F4E79;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="ngx" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;TCP 5000&lt;/b&gt;" style="endArrow=block;html=1;rounded=0;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#C1272D;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="a1" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;TCP 5000&lt;/b&gt;" style="endArrow=block;html=1;rounded=0;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#C1272D;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="a2" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="&lt;b&gt;HTTP 80&lt;/b&gt;" style="endArrow=block;html=1;rounded=0;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#1F4E79;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="cli" target="ngx"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
