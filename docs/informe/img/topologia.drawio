<mxfile host="app.diagrams.net">
  <diagram name="Topologia" id="sd-castro-osorio-eval4">
    <mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="tit" value="&lt;b&gt;Topología del servicio de juegos (tabla de puntajes) · Equipo Castro - Osorio&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="1200" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="A = mecanismo elegido (gRPC, semana11/laboratorio/docker-compose.yml) · B = alternativa medida (Pyro5, semana12/laboratorio/docker-compose.yml). Ambos stacks usan la red sd_net y no se levantan a la vez." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="20" y="34" width="1360" height="20" as="geometry"/>
        </mxCell>

        <!-- Anfitrión -->
        <mxCell id="host" value="Computador del equipo (anfitrión) · Docker Desktop" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#595959;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="20" y="62" width="1360" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="hport" value="&lt;b&gt;localhost:50051&lt;/b&gt;&lt;br&gt;puerto publicado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;fontSize=11;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="470" y="78" width="150" height="40" as="geometry"/>
        </mxCell>

        <!-- ===================== A · gRPC ===================== -->
        <mxCell id="netA" value="A · gRPC (elegido) · red Docker sd_net (bridge)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBE9EA;strokeColor=#C1272D;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#C1272D;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="640" height="585" as="geometry"/>
        </mxCell>
        <mxCell id="cliA" value="&lt;b style=&quot;font-size:13px&quot;&gt;cliente&lt;/b&gt;&lt;br&gt;sd_cliente · sd_grpc:semana11&lt;br&gt;&lt;hr&gt;cliente_grpc.py · medir.py&lt;br&gt;stub PartidaStub&lt;br&gt;deadline TIMEOUT_CLIENTE = 2 s&lt;br&gt;REINTENTOS con el mismo id_solicitud&lt;br&gt;sin puertos (sleep infinity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="215" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="srvA" value="&lt;b style=&quot;font-size:13px&quot;&gt;servidor&lt;/b&gt;&lt;br&gt;sd_servidor · sd_grpc:semana11&lt;br&gt;&lt;hr&gt;servidor_grpc.py · escucha TCP 50051&lt;br&gt;servicio partida.v1.Partida&lt;br&gt;Tabla · Unir · Anotar&lt;br&gt;ThreadPoolExecutor(max_workers=10)&lt;br&gt;&lt;hr&gt;&lt;b&gt;Estado:&lt;/b&gt; dominio._puntajes (memoria)&lt;br&gt;&lt;b&gt;DEDUP=1:&lt;/b&gt; _vistas id_solicitud → respuesta&lt;br&gt;FALLA · DEMORA · DEDUP por variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="405" y="200" width="260" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="rpcA" value="&lt;b&gt;rpc.py · uvicorn TCP 8000&lt;/b&gt;&lt;br&gt;JSON-RPC 2.0 sobre el mismo dominio.py&lt;br&gt;proceso aparte dentro de sd_servidor,&lt;br&gt;solo para la medición (docker compose exec -d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;dashed=1;fontSize=10;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="405" y="470" width="260" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="eA1" value="gRPC · HTTP/2&lt;br&gt;TCP 50051&lt;br&gt;protobuf (unario)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#C1272D;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="cliA" target="srvA">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="340" y="315"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eA2" value="JSON-RPC · HTTP/1.1 · TCP 8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#595959;dashed=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#FBE9EA;" edge="1" parent="1" source="cliA" target="rpcA">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="172" y="507"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eA3" value="ports 50051:50051" style="html=1;endArrow=block;endFill=1;strokeColor=#595959;fontSize=10;fontColor=#404040;labelBackgroundColor=#F4F4F4;" edge="1" parent="1" source="hport" target="srvA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="notaA" value="&lt;b&gt;Rol de cada nodo&lt;/b&gt;&lt;br&gt;cliente: inicia todas las llamadas; genera id_solicitud una vez y lo repite en cada reintento.&lt;br&gt;servidor: único nodo con estado; aplica el dominio con un Lock y, con DEDUP=1, recuerda las solicitudes ya aplicadas (at-most-once)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="610" height="70" as="geometry"/>
        </mxCell>

        <!-- ===================== B · Pyro5 ===================== -->
        <mxCell id="netB" value="B · Pyro5 (alternativa) · red Docker sd_net (bridge) · nada publicado al anfitrión" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#1F4E79;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="710" y="140" width="650" height="585" as="geometry"/>
        </mxCell>
        <mxCell id="nsB" value="&lt;b style=&quot;font-size:13px&quot;&gt;nombres&lt;/b&gt;&lt;br&gt;sd_nombres · python -m Pyro5.nameserver&lt;br&gt;&lt;hr&gt;escucha TCP 9090&lt;br&gt;sd.castro-osorio.juegos →&lt;br&gt;PYRO:juegos@servidor:9100&lt;br&gt;registro solo en memoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="930" y="180" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="cliB" value="&lt;b style=&quot;font-size:13px&quot;&gt;cliente&lt;/b&gt;&lt;br&gt;sd_cliente · laboratorio-cliente&lt;br&gt;&lt;hr&gt;cliente_pyro.py · medir.py&lt;br&gt;Proxy PYRONAME:sd.castro-osorio.juegos&lt;br&gt;_pyroTimeout = 5 s&lt;br&gt;sin puertos (sleep infinity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="730" y="400" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="srvB" value="&lt;b style=&quot;font-size:13px&quot;&gt;servidor&lt;/b&gt;&lt;br&gt;sd_servidor · laboratorio-servidor&lt;br&gt;&lt;hr&gt;servidor_pyro.py · Daemon TCP 9100&lt;br&gt;Juegos (objectId juegos, MODO=single)&lt;br&gt;Partida (obj_…, viaja por referencia)&lt;br&gt;&lt;hr&gt;&lt;b&gt;Estado:&lt;/b&gt; dominio._puntajes (memoria)&lt;br&gt;y cada Partida registrada en el daemon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1090" y="390" width="250" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="eB1" value="1 · lookup del nombre&lt;br&gt;Pyro/TCP 9090" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F4E79;strokeWidth=2;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#EAF1F8;" edge="1" parent="1" source="cliB" target="nsB">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="845" y="245"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eB2" value="registro al arrancar&lt;br&gt;(REREGISTRO=0)&lt;br&gt;Pyro/TCP 9090" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F4E79;dashed=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#EAF1F8;" edge="1" parent="1" source="srvB" target="nsB">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1265" y="245"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eB3" value="2 · llamadas a métodos&lt;br&gt;Pyro/TCP 9100 · serpent" style="html=1;endArrow=block;endFill=1;strokeColor=#C1272D;strokeWidth=2;fontSize=10;fontColor=#C1272D;labelBackgroundColor=#EAF1F8;" edge="1" parent="1" source="cliB" target="srvB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="notaB" value="&lt;b&gt;Rol de cada nodo&lt;/b&gt;&lt;br&gt;nombres: traduce el nombre lógico a la URI del daemon; solo se usa para entrar.&lt;br&gt;servidor: aloja los objetos Juegos y Partida y todo el estado.&lt;br&gt;cliente: resuelve el nombre una vez y luego habla directo con el daemon." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="730" y="600" width="620" height="70" as="geometry"/>
        </mxCell>

        <!-- Leyenda -->
        <mxCell id="ley" value="Borde rojo = nodo con estado · flecha desde quien inicia la conexión · línea punteada = conexión secundaria o solo de medición" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="40" y="727" width="1000" height="14" as="geometry"/>
