        <!-- Qué pasa si cae cada nodo -->
        <mxCell id="fallas" value="&lt;b&gt;Qué pasa si cae cada nodo (probado el 27-11-2026)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;procesador&lt;/b&gt; · el mensaje sin ack vuelve a la cola y lo toma la otra réplica (REENTREGADO). Si ya se había aplicado, Juegos.aplicar reconoce el id_solicitud y no suma dos veces.&lt;br&gt;&lt;b&gt;servidor&lt;/b&gt; · las jugadas esperan en la cola: el procesador hace nack con reencolar cada 2 s hasta que el servidor vuelve. La tabla en memoria se pierde (limitación conocida de la semana 12).&lt;br&gt;&lt;b&gt;rabbitmq&lt;/b&gt; · cola durable + mensajes persistentes: las jugadas pendientes sobreviven al reinicio (paso 2 del laboratorio).&lt;br&gt;&lt;b&gt;nombres&lt;/b&gt; · los proxies ya conectados siguen funcionando. Al volver, el servidor se re-registra a los 5 s (REREGISTRO=5)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#595959;fontSize=11;fontColor=#262626;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1220" height="140" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
