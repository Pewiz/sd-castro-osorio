<mxfile host="app.diagrams.net">
  <diagram name="Topologia con cola" id="sd-castro-osorio-proyecto-colas">
    <mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="tit" value="&lt;b&gt;Proyecto integrador · servicio de juegos con cola de jugadas · Equipo Castro - Osorio&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="1200" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="proyecto/docker-compose.yml (semana 13). Rojo, lo nuevo: broker RabbitMQ y procesadores (AMQP sobre TCP 5672). Azul, lo de la semana 12: objetos Pyro5. Línea punteada, búsqueda o registro de nombres." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="20" y="34" width="1260" height="20" as="geometry"/>
        </mxCell>

        <!-- Anfitrión -->
