        <!-- Nodos nuevos (cola) -->
        <mxCell id="pub" value="&lt;b style=&quot;font-size:13px&quot;&gt;publicador&lt;/b&gt;&lt;br&gt;run --rm · publicador.py&lt;br&gt;&lt;br&gt;El juego al terminar una ronda.&lt;br&gt;Deja UNIR / ANOTAR con un&lt;br&gt;id_solicitud y sigue sin esperar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="rmq" value="&lt;b style=&quot;font-size:13px&quot;&gt;rabbitmq&lt;/b&gt;&lt;br&gt;sd_rabbitmq · rabbitmq:4-management&lt;br&gt;&lt;br&gt;cola &lt;b&gt;operaciones&lt;/b&gt;&lt;br&gt;durable, mensajes persistentes&lt;br&gt;AMQP 5672 · consola 15672" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9EA;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="proc2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="186" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="proc" value="&lt;b style=&quot;font-size:13px&quot;&gt;procesador × 2&lt;/b&gt;&lt;br&gt;proyecto-procesador-1 y -2&lt;br&gt;&lt;br&gt;Sin estado. prefetch=1, ack manual&lt;br&gt;al terminar. Llama al servidor real.&lt;br&gt;Servidor caído: nack y reintento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="200" width="230" height="120" as="geometry"/>
        </mxCell>

        <!-- Nodos de la semana 12 (Pyro5) -->
        <mxCell id="srv" value="&lt;b style=&quot;font-size:13px&quot;&gt;servidor&lt;/b&gt;&lt;br&gt;sd_servidor · daemon Pyro5 · 9100&lt;br&gt;&lt;br&gt;&lt;b&gt;Juegos&lt;/b&gt; tabla, unir, anotar,&lt;br&gt;abrir_partida, &lt;b&gt;aplicar(id, op, args)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Partida&lt;/b&gt; por referencia&lt;br&gt;Único nodo con estado: tabla e&lt;br&gt;ids ya aplicados (en memoria)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="990" y="190" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ns" value="&lt;b style=&quot;font-size:13px&quot;&gt;nombres&lt;/b&gt;&lt;br&gt;sd_nombres · Pyro5 nameserver · 9090&lt;br&gt;&lt;br&gt;sd.castro-osorio.juegos&lt;br&gt;→ PYRO:juegos@servidor:9100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="990" y="420" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cli" value="&lt;b style=&quot;font-size:13px&quot;&gt;cliente&lt;/b&gt;&lt;br&gt;sd_cliente · cliente_pyro.py&lt;br&gt;&lt;br&gt;Consulta la tabla y abre partidas&lt;br&gt;(llamada directa, síncrona)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontColor=#262626;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="230" height="100" as="geometry"/>
        </mxCell>

        <!-- Flechas nuevas, AMQP -->
        <mxCell id="e1" value="AMQP 5672&lt;br&gt;publica jugada" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C1272D;strokeWidth=2;fontSize=10;fontColor=#C1272D;" edge="1" parent="1" source="pub" target="rmq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="AMQP 5672&lt;br&gt;entrega · ack" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C1272D;strokeWidth=2;fontSize=10;fontColor=#C1272D;" edge="1" parent="1" source="rmq" target="proc">
