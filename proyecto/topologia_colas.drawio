        <!-- Red sd_net -->
        <mxCell id="net" value="red Docker sd_net (bridge)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#595959;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1220" height="420" as="geometry"/>
