        <mxCell id="e3" value="Pyro 9100&lt;br&gt;Juegos.aplicar()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C1272D;strokeWidth=2;fontSize=10;fontColor=#C1272D;" edge="1" parent="1" source="proc" target="srv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="HTTP 15672" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontSize=10;fontColor=#595959;" edge="1" parent="1" source="nav" target="rmq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Flechas Pyro5 -->
        <mxCell id="e5" value="Pyro 9100&lt;br&gt;tabla(), abrir_partida()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#1F4E79;strokeWidth=2;fontSize=10;fontColor=#1F4E79;" edge="1" parent="1" source="cli" target="srv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="450"/>
              <mxPoint x="940" y="300"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="busca nombre 9090" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F4E79;fontSize=10;fontColor=#1F4E79;" edge="1" parent="1" source="cli" target="ns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="registro cada 5 s" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F4E79;fontSize=10;fontColor=#1F4E79;" edge="1" parent="1" source="srv" target="ns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="busca nombre 9090" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#C1272D;fontSize=10;fontColor=#C1272D;" edge="1" parent="1" source="proc" target="ns">
          <mxGeometry relative="1" as="geometry">
